# Browser origins allowed to call FastAPI.
# Multiple origins are comma-separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ollama
OLLAMA_HOST=http://localhost:11434

# AI models
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5:7b
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Vector database persistence directory.
# Docker/production should mount persistent storage here.
VECTOR_DATA_DIR=.

# Optional individual path overrides.
# VECTOR_DB_FILE=vector_database.pkl
# VECTOR_WAL_FILE=vector_database.wal

# PostgreSQL
DATABASE_URL=postgresql+psycopg://nabla:nabla_dev@localhost:5432/nabla

# Authentication
# Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60