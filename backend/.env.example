
# ==========================================================
# NeueBit Backend Environment Configuration
# ==========================================================

# Browser origins allowed to call FastAPI.
# Multiple origins are comma-separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ==========================================================
# Ollama
# ==========================================================

# Used for local LLM inference and document/query embeddings.
# Hosted LLM providers do not replace Ollama embeddings.
OLLAMA_HOST=http://localhost:11434


# ==========================================================
# AI Models
# ==========================================================

# Embeddings: keep consistent with the existing vector index.
EMBEDDING_MODEL=nomic-embed-text

# Local Ollama generation model.
LLM_MODEL=qwen2.5:7b

# CrossEncoder reranking model.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2


# ==========================================================
# LLM Provider Selection
# ==========================================================

# Supported primary providers:
#   ollama - local generation, default
#   groq   - hosted generation
LLM_PROVIDER=ollama

# Supported fallback providers:
#   none   - no fallback, default
#   gemini - fallback only when primary is Groq
#
# Valid combinations:
#   ollama + none
#   groq   + none
#   groq   + gemini
LLM_FALLBACK_PROVIDER=none


# ==========================================================
# Hosted LLM Models
# ==========================================================

GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.5-flash-lite


# ==========================================================
# Hosted LLM API Credentials
# ==========================================================

# Set these securely in your actual runtime environment.
# Never commit real API keys.
#
# Required when LLM_PROVIDER=groq:
# GROQ_API_KEY=
#
# Also required when LLM_FALLBACK_PROVIDER=gemini:
# GEMINI_API_KEY=
#
# IMPORTANT:
# Gemini fallback sends retrieved RAG context to Google.
# Review the provider's data-use terms before enabling
# fallback for private user documents.


# ==========================================================
# Custom Vector Database Persistence
# ==========================================================

# Docker/production must mount persistent storage here.
# Production example: VECTOR_DATA_DIR=/data
VECTOR_DATA_DIR=.

# Optional individual path overrides.
# VECTOR_DB_FILE=vector_database.pkl
# VECTOR_WAL_FILE=vector_database.wal


# ==========================================================
# PostgreSQL
# ==========================================================

# Local development example only.
# Production credentials must be set securely.
DATABASE_URL=postgresql+psycopg://nabla:nabla_dev@localhost:5432/nabla


# ==========================================================
# Authentication
# ==========================================================

# Generate a strong secret with:
# python -c "import secrets; print(secrets.token_hex(32))"
#
# Replace this value before running the application.
JWT_SECRET_KEY=replace-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60


# ==========================================================
# Vector Engine Operator Access
# ==========================================================

# User IDs allowed to rebuild or snapshot the shared index.
#
# Empty by default:
# Both operations return 403 for every authenticated user.
#
# Register a trusted account, find its ID through
# /api/v1/auth/me, then set that ID and restart the backend.
#
# Example:
# OPERATOR_USER_IDS=1,2

OPERATOR_USER_IDS=
